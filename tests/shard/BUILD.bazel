load("@rules_python//python:py_test.bzl", "py_test")

py_test(
    name = "test_shard",
    srcs = ["test_shard.py"],
    deps = ["//pytest_bazel"],
)

py_test(
    name = "test_shard_sharded",
    srcs = ["test_shard.py"],
    main = "test_shard.py",
    shard_count = 3,
    deps = ["//pytest_bazel"],
)

# Some of the shards get no tests, they must pass.
py_test(
    name = "test_more_shards_than_tests",
    srcs = ["test_more_shards_than_tests.py"],
    shard_count = 4,
    deps = ["//pytest_bazel"],
)
