# The metadata duplicates pyproject.toml, :whl_test checks that they match.
load("@rules_python//python:packaging.bzl", "py_package", "py_wheel")
load("@rules_python//python:py_test.bzl", "py_test")

licenses(["notice"])  # Apache 2.0

py_package(
    name = "srcs",
    packages = ["pytest_bazel"],
    deps = ["//pytest_bazel"],
)

# TODO @aignas 2024-06-29: Consider having `repairwheel` here so that it actually works
py_wheel(
    name = "whl",
    author = "Ignas Anikevicius",
    author_email = "pypi@anikevicius.lt",
    classifiers = [
        "Development Status :: 4 - Beta",
        "Programming Language :: Python",
    ],
    description_file = "//:README.md",
    # The wheel with the stamped version is in `bazel-bin/pkg/dist`.
    dist_folder = "dist",
    distribution = "pytest_bazel",
    entry_points = {
        "console_scripts": ["pytest_bazel = pytest_bazel:main"],
    },
    extra_distinfo_files = {
        "//:LICENSE": "LICENSE",
        "//:README.md": "README",
    },
    homepage = "https://github.com/aignas/pytest-bazel",
    license = "Apache 2.0",
    project_urls = {
        "Bug Tracker": "https://github.com/aignas/pytest-bazel/issues",
        "Changelog": "https://github.com/aignas/pytest-bazel/blob/main/CHANGELOG.md",
        "Documentation": "https://github.com/aignas/pytest-bazel",
        "Homepage": "https://github.com/aignas/pytest-bazel",
        "Repository": "https://github.com/aignas/pytest-bazel.git",
    },
    python_requires = ">=3.8",
    python_tag = "py3",
    requires = [
        "pytest",
    ],
    extra_requires = {
        "all": [
            "pytest-bazel[random]",
            "pytest-bazel[shard]",
        ],
        "random": ["pytest-randomly"],
        "shard": ["pytest-shard"],
    },
    summary = "A pytest runner with bazel support",
    # Set from the release tag with `--stamp --embed_label=<version>`, see
    # .github/workflows/release.yaml. Unstamped builds get `0+build.embed.label`.
    version = "{BUILD_EMBED_LABEL}",
    visibility = ["//tests:__subpackages__"],
    deps = [":srcs"],
)

py_test(
    name = "whl_test",
    srcs = ["whl_test.py"],
    data = [
        ":whl",
        "//:pyproject.toml",
    ],
    env = {
        "PYPROJECT": "$(rootpath //:pyproject.toml)",
        "WHEEL_DIR": package_name(),
    },
    # For tomllib
    python_version = "3.12",
)
