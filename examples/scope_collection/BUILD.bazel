load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_library(
    name = "own",
    testonly = True,
    srcs = ["test_own.py"],
)

[
    py_test(
        name = name,
        env = env,
        main_module = "pytest_bazel",
        tags = ["manual"],
        deps = [
            ":own",
            "//examples/scope_collection/dep",
            "//pytest_bazel",
        ],
    )
    for name, env in {
        "off_test": {"PYTEST_BAZEL_SCOPE_COLLECTION_TO_PACKAGE": "0"},
        "scoped_test": {},
    }.items()
]
