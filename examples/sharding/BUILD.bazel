load("@rules_python//python:py_test.bzl", "py_test")

py_test(
    name = "sharding_test",
    srcs = ["test_sharding.py"],
    main = "test_sharding.py",
    shard_count = 3,
    tags = ["manual"],
    deps = ["//pytest_bazel"],
)

