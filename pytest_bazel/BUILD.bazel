load("@rules_python//python:py_library.bzl", "py_library")

# The sources alone, for the wheel. The py_library would add the .pyc files
# that the precompile setting of .bazelrc creates.
filegroup(
    name = "srcs",
    srcs = glob(["**/*.py"]),
    visibility = ["//pkg:__pkg__"],
)

py_library(
    name = "pytest_bazel",
    srcs = [":srcs"],
    deps = [
        "@pypi//pytest",
    ],
    visibility = ["//:__subpackages__"],
)
